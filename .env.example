REALTIME_FIREBASE_DB=
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the client bundle.
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
# Firebase Console -> Project settings -> Your apps -> Web app -> SDK setup
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Firebase Console -> Authentication -> Sign-in method -> Google -> Web SDK configuration
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional: only needed for standalone native builds (Google Cloud Console OAuth clients)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# https://spoonacular.com/food-api (free tier ~150 requests/day)
EXPO_PUBLIC_SPOONACULAR_KEY=
